class Rectangle {
    int length;
    int breadth;

   
    Rectangle() {
        length = 1;
        breadth = 1;
    }


    Rectangle(int l, int b) {
        length = l;
        breadth = b;
    }


    Rectangle(int side) {
        length = side;
        breadth = side;
    }

    void area() {
        System.out.println("Area = " + (length * breadth));
    }
}

public class Main {
    public static void main(String[] args) {

        Rectangle r1 = new Rectangle();
        Rectangle r2 = new Rectangle(10, 5);
        Rectangle r3 = new Rectangle(7);

        r1.area();
        r2.area();
        r3.area();
    }
}
