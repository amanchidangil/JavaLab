import java.applet.Applet;
import java.awt.Graphics;

public class AnimationApplet extends Applet implements Runnable {

    int x = 0;
    Thread t;
    boolean running = false;

    public void init() {
        x = 0;
    }

    public void start() {
        running = true;

        if (t == null) {
            t = new Thread(this);
            t.start();
        }
    }

    public void run() {
        while (running) {
            x = x + 5;

            if (x > getWidth()) {
                x = 0;
            }

            repaint();

            try {
                Thread.sleep(100);
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }
    }

    public void paint(Graphics g) {
        g.fillOval(x, 100, 40, 40);
    }

    public void stop() {
        running = false;
        t = null;
    }
}
