import java.awt.*;
import java.awt.event.*;

public class MouseKeyboardDemo extends Frame {

    Label mousePosition;
    Label keyPressed;

    MouseKeyboardDemo() {
        setTitle("Mouse and Keyboard Events");
        setSize(500, 300);
        setLayout(new FlowLayout());

        mousePosition = new Label("Mouse Position: ");
        keyPressed = new Label("Key Pressed: ");

        add(mousePosition);
        add(keyPressed);

     
        addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent e) {
                mousePosition.setText(
                    "Mouse Clicked at: X=" + e.getX() +
                    " Y=" + e.getY()
                );
            }
        });

        
        addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseMoved(MouseEvent e) {
                mousePosition.setText(
                    "Mouse Position: X=" + e.getX() +
                    " Y=" + e.getY()
                );
            }
        });

        
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                keyPressed.setText(
                    "Key Pressed: " + e.getKeyChar()
                );
            }
        });

        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent e) {
                dispose();
            }
        });

        setFocusable(true);
        setVisible(true);
    }

    public static void main(String[] args) {
        new MouseKeyboardDemo();
    }
}
